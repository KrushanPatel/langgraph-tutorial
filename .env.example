# Copy to .env and fill in. Every LG_ field maps to lg_prod.config.Settings.
# Only `python -m lg_prod --llm` needs a model key; everything else is offline.
ANTHROPIC_API_KEY=
LG_CHAT_MODEL=anthropic:claude-sonnet-5

# Persistence: memory | sqlite
LG_PERSISTENCE=memory
LG_SQLITE_PATH=incident_desk.sqlite
# 16/24/32-byte key -> checkpoints are AES-encrypted at rest
LANGGRAPH_AES_KEY=

# Execution
LG_DURABILITY=async
LG_RECURSION_LIMIT=50
LG_AUTO_REMEDIATE_MAX_SEVERITY=sev3
